# Neon Postgres connection strings
# Pooled (for application server & connection pooling)
DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require

# Unpooled / Direct (for database migrations & schema management)
DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require
DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# Secret for signing JWTs — change this in production!
JWT_SECRET=change_me_in_production_use_at_least_64_random_bytes

# HTTP port
PORT=4000

NODE_ENV=development

# Resend API Key for transactional emails
RESEND_API_KEY=
